<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.campus.runner.mapper.UserMapper">

    <!-- 动态更新用户信息（含校园扩展字段） -->
    <update id="update">
        update user
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="idNumber != null">id_number = #{idNumber},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="studentNo != null">student_no = #{studentNo},</if>
            <if test="campus != null">campus = #{campus},</if>
            <if test="creditScore != null">credit_score = #{creditScore},</if>
            <if test="publishOrderCount != null">publish_order_count = #{publishOrderCount},</if>
        </set>
        where id = #{id}
    </update>
    <!-- 管理端-用户列表分页 -->
    <select id="page" resultType="com.campus.runner.entity.User">
        select * from user
        <where>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="phone != null and phone != ''">and phone like concat('%', #{phone}, '%')</if>
            <if test="campus != null and campus != ''">and campus like concat('%', #{campus}, '%')</if>
        </where>
        order by create_time desc
    </select>
</mapper>
