<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.campus.runner.mapper.CreditLogMapper">

    <!-- 技能者信用分流水 -->
    <select id="listBySkiller" resultType="com.campus.runner.entity.CreditLog">
        select * from credit_log where skiller_id = #{skillerId} order by create_time desc
    </select>
</mapper>
