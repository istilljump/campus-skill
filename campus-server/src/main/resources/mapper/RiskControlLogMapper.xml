<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.campus.runner.mapper.RiskControlLogMapper">

    <!-- 风控告警分页 -->
    <select id="page" resultType="com.campus.runner.entity.RiskControlLog">
        select * from risk_control_log
        <where>
            <if test="status != null">and status = #{status}</if>
            <if test="level != null">and risk_level = #{level}</if>
        </where>
        order by id desc
    </select>
</mapper>
