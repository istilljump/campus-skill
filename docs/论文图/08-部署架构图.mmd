flowchart TB
    subgraph Client["客户端（浏览器访问）"]
        W1["Web 门户<br/>web-app 静态资源"]
        W2["双身份 H5<br/>user-app"]
        W3["管理端<br/>admin-web"]
    end

    subgraph Host["应用服务器（单机部署 / 可横向扩展）"]
        APP["campus-server.jar<br/>SpringBoot 2.7 内嵌 Tomcat<br/>JDK 17"]
        subgraph modules["内嵌组件"]
            MVC["MVC + 三端 JWT 拦截"]
            SCHED["定时任务引擎"]
            WS["WebSocket 端点"]
        end
    end

    subgraph Storage["数据存储（本机 / 独立主机）"]
        MYSQL[("MySQL 8.0<br/>campus_runner")]
        REDIS[("Redis 5+")]
    end

    W1 -- HTTP 8080 --> APP
    W2 -- HTTP 8080 --> APP
    W3 -- HTTP 8080 --> APP
    APP --> MYSQL
    APP -- 缓存/限流/Lua --> REDIS
    WS -- 实时推送 --> W1
    WS --> W2

    note1["静态资源随 jar 发布：<br/>tools/build-frontends.mjs 构建同步"] -.-> APP
